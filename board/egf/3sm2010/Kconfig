if TARGET_EGF_3SM2010

config SYS_BOARD
	default "3sm2010"

config SYS_VENDOR
	default "egf"

config SYS_CONFIG_NAME
	default "egf_3sm2010"

config IMX_CONFIG
	default "board/freescale/imx8mm_evk/imximage-8mm.cfg"

config MFG_EMB_DDR
	bool "Force embedded DDR Memory timings without reading EEPROM"
	default n


choice MFG_WID_OPTIONS
	prompt "Select WID to force embedded DDR timings"
	depends on MFG_EMB_DDR

	config FORCE_WID0727AB0101
		bool "Select WID0727_AB01.01"

endchoice

endif
