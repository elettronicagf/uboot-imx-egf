if TARGET_EGF_3SM1008

config SYS_BOARD
	default "3sm1008"

config SYS_VENDOR
	default "egf"

config SYS_CONFIG_NAME
	default "egf_3sm1008"

config IMX_CONFIG
	default "board/freescale/imx8mm_evk/imximage-8mm.cfg"

config MFG_EMB_DDR
	bool "Force embedded DDR Memory timings without reading EEPROM"
	default n


choice MFG_WID_OPTIONS
	prompt "Select WID to force embedded DDR timings"
	depends on MFG_EMB_DDR

	config FORCE_WID0670AA0101
		bool "Select WID0670_AA01.01"

endchoice

endif
