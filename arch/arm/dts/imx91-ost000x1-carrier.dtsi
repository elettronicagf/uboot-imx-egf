#include <dt-bindings/leds/common.h>

/ {

	aliases {
		rtc0 = &pcf85263;
	};

	// REGULATORS
	reg_5v_sys: regulator-5V-sys {
		// U3 system voltage 5V TPS54361 @3.5A
		compatible = "regulator-fixed";
		regulator-name = "VSYS_5V";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
	};

	reg_3v3: regulator-3V3 {
		// U7 regulator for 3V3 TPS54361 @3.5A
		compatible = "regulator-fixed";
		regulator-name = "REG_3V3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;

	};

	reg_1v8_vdd: regulator-1V8 {
		// U1 regulator for 1V8 AP7361E @1A
		compatible = "regulator-fixed";
		regulator-name = "REG_1V8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&reg_3v3>;
	};

	reg_aon_dly: regulator-aon-dly {
		// U6 regulator for 1V8 or 3V3 dependig on mountig
		compatible = "regulator-fixed";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_reg_aon_dly>;
		regulator-name = "REG_AON_DLY";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&reg_3v3>;
		gpio = <&gpio1 10 GPIO_ACTIVE_HIGH>;
		off-on-delay-us = <12000>;
		enable-active-high;
	};

	reg_usdhc2_vmmc: regulator-usdhc2  {
		// uSD2 pwr-enable
		compatible = "regulator-fixed";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_reg_usdhc2_vmmc>;
		regulator-name = "VSD2_3V3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&reg_3v3>;
		gpio = <&gpio2 16 GPIO_ACTIVE_HIGH>;
		off-on-delay-us = <12000>;
		enable-active-high;		
	};

	reg_usdhc3_vmmc: regulator-usdhc3  {
		// uSD3 pwr-enable
		compatible = "regulator-fixed";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_reg_usdhc3_vmmc>;
		regulator-name = "VSD3_3V3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&reg_3v3>;
		gpio = <&gpio2 17 GPIO_ACTIVE_HIGH>;
		off-on-delay-us = <12000>;
		enable-active-high;
	};

	reg_usb1: regulator-usb1 {
		// U23 regulator for USB1 AP22811AW5-7
		compatible = "regulator-fixed";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_reg_usb_vbus1>;
		regulator-name = "USB_VBUS1";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&reg_5v_sys>;
		gpio = <&gpio2 12 GPIO_ACTIVE_HIGH>;
		off-on-delay-us = <12000>;
		enable-active-high;
	};

	reg_usb2: regulator-usb2 {
		// U24 regulator for USB2 AP22811AW5-7
		compatible = "regulator-fixed";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_reg_usb_vbus2>;
		regulator-name = "USB_VBUS2";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&reg_5v_sys>;
		gpio = <&gpio2 14 GPIO_ACTIVE_HIGH>;
		off-on-delay-us = <12000>;
		enable-active-high;
	};

};

//=============================================================================
//=== EQOS
//=============================================================================
&eqos {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_eqos>;
	phy-mode = "rgmii-id";
	phy-handle = <&ethphy1>;
	status = "okay";

	mdio {
		compatible = "snps,dwmac-mdio";
		#address-cells = <1>;
		#size-cells = <0>;
		clock-frequency = <5000000>;

		ethphy1: ethernet-phy@7 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <7>;
			eee-broken-1000t;
		};
	};
};

//=============================================================================
//=== FEC
//=============================================================================
&fec {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_fec>;
	phy-mode = "rgmii-id";
	phy-handle = <&ethphy2>;
	fsl,magic-packet;
	status = "okay";

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;
		clock-frequency = <5000000>;

		ethphy2: ethernet-phy@5 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <5>;
			eee-broken-1000t;
		};
	};
};

//=============================================================================
//=== CAN1
//=============================================================================
&flexcan1 {
	status = "disabled";
};

//=============================================================================
//=== I2C1
//=============================================================================
&lpi2c1 {
	status = "okay";
	
	pcf85263: rtc@51 {
		compatible = "nxp,pcf85263";
		reg = <0x51>;
	};	
};	
	
//=============================================================================
//=== I2C2
//=============================================================================
&lpi2c2 {
	status = "okay";
	
	eeprom_at24mac402: eeprom@50 {
		compatible = "atmel,24c02";
		reg = <0x50>;
		pagesize = <16>;
	};
	
};

//=============================================================================
//=== I2C5
//=============================================================================
&lpi2c5 {
	status = "okay";
};	

//=============================================================================
//=== SPI1
//=============================================================================
&lpspi1 {
	#address-cells = <1>;
	#size-cells = <0>;
	fsl,spi-num-chipselects = <1>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_lpspi1>;
	cs-gpios = <&gpio1 11 GPIO_ACTIVE_LOW>;
	status = "okay";
};

//=============================================================================
//=== SPI6
//=============================================================================
&lpspi6 {
	#address-cells = <1>;
	#size-cells = <0>;
	fsl,spi-num-chipselects = <1>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_lpspi6>;
	cs-gpios = <&gpio2 00 GPIO_ACTIVE_LOW>;
	status = "okay";
};

//=============================================================================
//=== UART1 console
//=============================================================================
&lpuart1 { /* console */
	status = "okay";
};

//=============================================================================
//=== UART2
//=============================================================================
&lpuart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart2>;
	status = "okay";
};

//=============================================================================
//=== UART6 RS232
//=============================================================================
&lpuart6 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart6>;
	uart-has-rtscts;
	status = "okay";
};

//=============================================================================
//=== UART7 RS232
//=============================================================================
&lpuart7 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart7>;
	uart-has-rtscts;
	status = "okay";
};

//=============================================================================
//=== USB1
//=============================================================================
&usbotg1 {
	status = "okay";
};

//=============================================================================
//=== USB2
//=============================================================================
&usbotg2 {
	status = "okay";
};

//=============================================================================
//=== USDHC2 usd
//=============================================================================
&usdhc2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usdhc2>, <&pinctrl_usdhc2_gpio>;
	cd-gpios = <&gpio3 00 GPIO_ACTIVE_LOW>;
	vmmc-supply = <&reg_usdhc2_vmmc>;
	bus-width = <4>;
	no-sdio;
	no-mmc;
	status = "okay";
};

//=============================================================================
//=== USDHC3 usd
//=============================================================================
&usdhc3 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usdhc3>, <&pinctrl_usdhc3_gpio>;
	cd-gpios = <&gpio2 20 GPIO_ACTIVE_LOW>;
	vmmc-supply = <&reg_usdhc3_vmmc>;
	bus-width = <4>;
	no-sdio;
	no-mmc;
	status = "disabled";
};



//=============================================================================
//#############################################################################
//=== PINMUX
//#############################################################################
//=============================================================================
&iomuxc {

	pinctrl_reg_aon_dly: regaondlygrp {
		fsl,pins = <
			MX91_PAD_PDM_BIT_STREAM1__GPIO1_IO10						0x51e
		>;
	};

	pinctrl_reg_usdhc2_vmmc: regusdhc2vmmcgrp {
		fsl,pins = <
			MX91_PAD_GPIO_IO16__GPIO2_IO16								0x31e
		>;
	};

	pinctrl_reg_usdhc3_vmmc: regusdhc3vmmcgrp {
		fsl,pins = <
			MX91_PAD_GPIO_IO17__GPIO2_IO17								0x31e
		>;
	};

	pinctrl_lpspi1: lpspi1grp {
		fsl,pins = <
			MX91_PAD_SAI1_TXFS__GPIO1_IO11								0x000009fe
			MX91_PAD_SAI1_RXD0__LPSPI1_SOUT            					0x000005fe
			MX91_PAD_SAI1_TXC__LPSPI1_SIN              					0x000005fe
			MX91_PAD_SAI1_TXD0__LPSPI1_SCK             					0x000005fe
		>;
	};

	pinctrl_lpspi6: lpspi6grp {
		fsl,pins = <
			MX91_PAD_GPIO_IO00__GPIO2_IO0								0x000009fe
			MX91_PAD_GPIO_IO02__LPSPI6_SOUT            					0x000005fe
			MX91_PAD_GPIO_IO01__LPSPI6_SIN              				0x000005fe
			MX91_PAD_GPIO_IO03__LPSPI6_SCK             					0x000005fe
		>;
	};

	pinctrl_uart2: uart2grp {
		fsl,pins = <
			MX91_PAD_UART2_TXD__LPUART2_TX								0x31e
			MX91_PAD_UART2_RXD__LPUART2_RX								0x31e
		>;
	};

	pinctrl_uart6: uart6grp {
		fsl,pins = <
		    MX91_PAD_GPIO_IO04__LPUART6_TX								0x51e
            MX91_PAD_GPIO_IO05__LPUART6_RX								0x51e
            MX91_PAD_GPIO_IO06__LPUART6_CTS_B							0x51e
            MX91_PAD_GPIO_IO07__LPUART6_RTS_B							0x51e
		>;
	};

	pinctrl_uart7: uart7grp {
		fsl,pins = <
		    MX91_PAD_GPIO_IO08__LPUART7_TX								0x51e
            MX91_PAD_GPIO_IO09__LPUART7_RX								0x51e
            MX91_PAD_GPIO_IO10__LPUART7_CTS_B							0x51e
            MX91_PAD_GPIO_IO11__LPUART7_RTS_B							0x51e
		>;
	};

	pinctrl_reg_usb_vbus1: regusbvbus1grp {
		fsl,pins = <
			MX91_PAD_GPIO_IO12__GPIO2_IO12								0x31e
		>;
	};

	pinctrl_reg_usb_vbus2: regusbvbus2grp {
		fsl,pins = <
			MX91_PAD_GPIO_IO14__GPIO2_IO14								0x31e
		>;
	};

	pinctrl_eqos: eqosgrp {
		fsl,pins = <
			MX91_PAD_ENET1_MDC__ENET1_MDC								0x57e
			MX91_PAD_ENET1_MDIO__ENET_QOS_MDIO							0x57e
			MX91_PAD_ENET1_RD0__ENET_QOS_RGMII_RD0						0x57e
			MX91_PAD_ENET1_RD1__ENET_QOS_RGMII_RD1						0x57e
			MX91_PAD_ENET1_RD2__ENET_QOS_RGMII_RD2						0x57e
			MX91_PAD_ENET1_RD3__ENET_QOS_RGMII_RD3						0x57e
			MX91_PAD_ENET1_RXC__ENET_QOS_RGMII_RXC						0x5fe
			MX91_PAD_ENET1_RX_CTL__ENET_QOS_RGMII_RX_CTL				0x57e
			MX91_PAD_ENET1_TD0__ENET_QOS_RGMII_TD0						0x57e
			MX91_PAD_ENET1_TD1__ENET1_RGMII_TD1							0x57e
			MX91_PAD_ENET1_TD2__ENET_QOS_RGMII_TD2						0x57e
			MX91_PAD_ENET1_TD3__ENET_QOS_RGMII_TD3						0x57e
			MX91_PAD_ENET1_TXC__CCM_ENET_QOS_CLOCK_GENERATE_TX_CLK		0x5fe
			MX91_PAD_ENET1_TX_CTL__ENET_QOS_RGMII_TX_CTL				0x57e
			MX91_PAD_CCM_CLKO1__GPIO3_IO26								0x91e
			MX91_PAD_CCM_CLKO3__GPIO4_IO28								0x31e
		>;
	};

	pinctrl_fec: fecgrp {
		fsl,pins = <
			MX91_PAD_ENET2_MDC__ENET2_MDC								0x57e
			MX91_PAD_ENET2_MDIO__ENET2_MDIO								0x57e
			MX91_PAD_ENET2_RD0__ENET2_RGMII_RD0							0x57e
			MX91_PAD_ENET2_RD1__ENET2_RGMII_RD1							0x57e
			MX91_PAD_ENET2_RD2__ENET2_RGMII_RD2							0x57e
			MX91_PAD_ENET2_RD3__ENET2_RGMII_RD3							0x57e
			MX91_PAD_ENET2_RXC__ENET2_RGMII_RXC							0x5fe
			MX91_PAD_ENET2_RX_CTL__ENET2_RGMII_RX_CTL					0x57e
			MX91_PAD_ENET2_TD0__ENET2_RGMII_TD0							0x57e
			MX91_PAD_ENET2_TD1__ENET2_RGMII_TD1							0x57e
			MX91_PAD_ENET2_TD2__ENET2_RGMII_TD2							0x57e
			MX91_PAD_ENET2_TD3__ENET2_RGMII_TD3							0x57e
			MX91_PAD_ENET2_TXC__ENET2_RGMII_TXC							0x5fe
			MX91_PAD_ENET2_TX_CTL__ENET2_RGMII_TX_CTL					0x57e
			MX91_PAD_CCM_CLKO2__GPIO3_IO27								0x91e
			MX91_PAD_CCM_CLKO4__GPIO4_IO29								0x31e
		>;
	};

	pinctrl_usdhc2_gpio: usdhc2gpiogrp {
		fsl,pins = <
			MX91_PAD_SD2_CD_B__GPIO3_IO0								0x31e
		>;
	};

	pinctrl_usdhc3_gpio: usdhc3gpiogrp {
		fsl,pins = <
			MX91_PAD_GPIO_IO20__GPIO2_IO20								0x31e
		>;
	};
	
	/* need to config the SION for data and cmd pad, refer to ERR052021 */
	pinctrl_usdhc2: usdhc2grp {
		fsl,pins = <			
			MX91_PAD_SD2_CLK__USDHC2_CLK								0x1506
			MX91_PAD_SD2_CMD__USDHC2_CMD								0x40001306
			MX91_PAD_SD2_DATA0__USDHC2_DATA0							0x40001306
			MX91_PAD_SD2_DATA1__USDHC2_DATA1							0x40001306
			MX91_PAD_SD2_DATA2__USDHC2_DATA2							0x40001306
			MX91_PAD_SD2_DATA3__USDHC2_DATA3							0x40001306
			MX91_PAD_SD2_VSELECT__USDHC2_VSELECT						0x51e
		>;
	};

	/* need to config the SION for data and cmd pad, refer to ERR052021 */
	pinctrl_usdhc2_100mhz: usdhc2-100mhzgrp {
		fsl,pins = <
			MX91_PAD_SD2_CLK__USDHC2_CLK								0x158e
			MX91_PAD_SD2_CMD__USDHC2_CMD								0x4000138e
			MX91_PAD_SD2_DATA0__USDHC2_DATA0							0x4000138e
			MX91_PAD_SD2_DATA1__USDHC2_DATA1							0x4000138e
			MX91_PAD_SD2_DATA2__USDHC2_DATA2							0x4000138e
			MX91_PAD_SD2_DATA3__USDHC2_DATA3							0x4000138e
			MX91_PAD_SD2_VSELECT__USDHC2_VSELECT						0x51e
		>;
	};

	/* need to config the SION for data and cmd pad, refer to ERR052021 */
	pinctrl_usdhc2_200mhz: usdhc2-200mhzgrp {
		fsl,pins = <
			MX91_PAD_SD2_CLK__USDHC2_CLK								0x15fe
			MX91_PAD_SD2_CMD__USDHC2_CMD								0x400013fe
			MX91_PAD_SD2_DATA0__USDHC2_DATA0							0x400013fe
			MX91_PAD_SD2_DATA1__USDHC2_DATA1							0x400013fe
			MX91_PAD_SD2_DATA2__USDHC2_DATA2							0x400013fe
			MX91_PAD_SD2_DATA3__USDHC2_DATA3							0x400013fe
			MX91_PAD_SD2_VSELECT__USDHC2_VSELECT						0x51e
		>;
	};

	/* need to config the SION for data and cmd pad, refer to ERR052021 */
	pinctrl_usdhc3: usdhc3grp {
		fsl,pins = <
			MX91_PAD_SD3_CLK__USDHC3_CLK								0x1506
			MX91_PAD_SD3_CMD__USDHC3_CMD								0x40001306
			MX91_PAD_SD3_DATA0__USDHC3_DATA0							0x40001306
			MX91_PAD_SD3_DATA1__USDHC3_DATA1							0x40001306
			MX91_PAD_SD3_DATA2__USDHC3_DATA2							0x40001306
			MX91_PAD_SD3_DATA3__USDHC3_DATA3							0x40001306
		>;
	};
	
	/* need to config the SION for data and cmd pad, refer to ERR052021 */
	pinctrl_usdhc3_100mhz: usdhc3-100mhzgrp {
		fsl,pins = <
			MX91_PAD_SD3_CLK__USDHC3_CLK								0x158e
			MX91_PAD_SD3_CMD__USDHC3_CMD								0x4000138e
			MX91_PAD_SD3_DATA0__USDHC3_DATA0							0x4000138e
			MX91_PAD_SD3_DATA1__USDHC3_DATA1							0x4000138e
			MX91_PAD_SD3_DATA2__USDHC3_DATA2							0x4000138e
			MX91_PAD_SD3_DATA3__USDHC3_DATA3							0x4000138e
		>;
	};

	/* need to config the SION for data and cmd pad, refer to ERR052021 */
	pinctrl_usdhc3_200mhz: usdhc3-200mhzgrp {
		fsl,pins = <
			MX91_PAD_SD3_CLK__USDHC3_CLK								0x15fe
			MX91_PAD_SD3_CMD__USDHC3_CMD								0x400013fe
			MX91_PAD_SD3_DATA0__USDHC3_DATA0							0x400013fe
			MX91_PAD_SD3_DATA1__USDHC3_DATA1							0x400013fe
			MX91_PAD_SD3_DATA2__USDHC3_DATA2							0x400013fe
			MX91_PAD_SD3_DATA3__USDHC3_DATA3							0x400013fe
		>;
	};
};
